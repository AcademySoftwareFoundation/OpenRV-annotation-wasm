{
  "name": "@aswf/annotation-platform",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AcademySoftwareFoundation/OpenRV-annotation-wasm.git"
  },
  "main": "./dist/annotation_platform.cjs.js",
  "exports": {
    ".": {
      "import": "./dist/annotation_platform.esm.mjs",
      "require": "./dist/annotation_platform.cjs.js",
      "default": "./dist/annotation_platform.cjs.js"
    },
    "./assets/*": "./deps/OpenRV-annotation/assets/*"
  },
  "files": [
    "annotation_platform.d.ts",
    "deps/OpenRV-annotation/assets/",
    "dist/"
  ],
  "types": "./annotation_platform.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:wasm": "make wasm",
    "build": "mkdir -p dist && cp build-wasm/bindings/wasm/annotation_platform.cjs.js dist/ && cp build-wasm/bindings/wasm/annotation_platform.esm.mjs dist/",
    "test": "node test/unit/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "c8": "^10.0.0",
    "prettier": "^3.0.0"
  }
}
